# ─────────────────────────────────────────────
#  Variables de entorno para el frontend PQRSF
#  Copia este archivo a .env.local y rellena los valores
# ─────────────────────────────────────────────

# URL base del backend Django
VITE_API_URL=http://localhost:8000

# URL base del backend SGD (Archivo Central) — Next.js
VITE_SGD_API_URL=http://localhost:3000/api

# Nunca ponga tokens ni claves en variables VITE_*: quedan dentro del JavaScript que descarga el navegador.
# Los webhooks de n8n los dispara el backend SGD (N8N_WEBHOOK_* en su .env.local).

# TEMPORAL: login de pruebas por perfil en /login-temporal (solo npm run dev; borrar antes del despliegue).
# La clave está solo en el backend (SGD_LOGIN_TEMPORAL_CLAVE).
VITE_LOGIN_TEMPORAL=

# Deshabilitar reCAPTCHA en desarrollo local (true | false)
# IMPORTANTE: mantener en false en producción.
VITE_DISABLE_CAPTCHA=false

# Site key PÚBLICA de reCAPTCHA (no es un secreto). Déjala vacía si VITE_DISABLE_CAPTCHA=true.
VITE_RECAPTCHA_SITE_KEY=

# Client ID de Google OAuth 2.0 (opcional en desarrollo; sin él el login con Google queda inactivo)
# Obtenlo en: https://console.cloud.google.com/ → APIs & Services → Credentials
# Crea un OAuth 2.0 Client ID de tipo "Web application"
# Agrega en "Authorized JavaScript origins": http://localhost:5173
# Agrega en "Authorized redirect URIs": http://localhost:5173
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Integración UniDoc embebida
# URL base del portal UniDoc (puede ser ruta proxied o dominio completo).
VITE_CONVOCATORIAS_APP_URL=/convocatorias-app
# Endpoint receptor SSO dentro de UniDoc.
VITE_CONVOCATORIAS_SSO_PATH=/api/auth/sso
# Ruta interna a la que debe aterrizar UniDoc tras validar el token.
VITE_CONVOCATORIAS_REDIRECT_PATH=/
